# ==========================================
# Remote AI Engineer Scout - Environment Variables
# ==========================================

# --- Target Role Configuration ---
# The job position to scout for (e.g., "Applied AI Engineer", "Machine Learning Engineer", "Data Engineer", "MLOps Engineer")
TARGET_ROLE=Applied AI Engineer

# --- LLM Provider Selection ---
# Supported options:
#   - "gemini:gemini-4-argon" (Default / Recommended)
#   - "gemini:gemini-2.5-flash"
#   - "openai:gpt-4o-mini"
#   - "zhipu:glm-4"
LLM_MODEL=gemini:gemini-4-argon

# --- LLM API Keys (set the one corresponding to your LLM_MODEL) ---
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ZHIPUAI_API_KEY=your_zhipuai_api_key_here

# --- Search Tool (Required) ---
TAVILY_API_KEY=your_tavily_api_key_here

# --- Telegram Bot Delivery & Alerts (Required for automated notifications) ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# --- LangSmith Tracing (Optional) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=remote-ai-scout
